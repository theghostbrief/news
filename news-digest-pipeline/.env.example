# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# На боевом сервере ставьте `production`. Авторизация отключается ТОЛЬКО при
# `development` или `test`; любое другое значение или пусто → авторизация
# ВКЛючена (fail-closed), чтобы мисконфиг не открыл API «по-тихому».
NODE_ENV=development
BASE_URL=https://news.questtales.com
DB_PATH=./data/news-digest.db

# ─── Auth (dashboard + API) ──────────────────────────────────────────────────
API_SECRET_KEY=change-me-to-a-strong-random-key
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# ─── LLM (vendor + model) ────────────────────────────────────────────────────
# LLM_VENDOR selects which API receives requests: anthropic | openai.
# CLAUDE_MODEL holds the active model id for the selected vendor (historical name;
# it is vendor-agnostic — put an OpenAI id here when LLM_VENDOR=openai).
LLM_VENDOR=anthropic
CLAUDE_MODEL=claude-sonnet-4-20250514

ANTHROPIC_API_KEY=sk-ant-...
# Leave *_BASE_URL empty to use the vendor default endpoint.
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=
# Reasoning depth for the OpenAI path only. Leave EMPTY to send nothing
# (current default). Suggested values: minimal | low | medium | high.
# An unsupported value is dropped automatically at runtime and retried.
OPENAI_REASONING_EFFORT=

# ─── Queue & generation ──────────────────────────────────────────────────────
ARTICLE_THRESHOLD=10
# 0-100 (%). Word-trigram overlap above which two ready articles are flagged
# as a possible duplicate story at compile time (never auto-dropped — always
# asks via Telegram first). See src/services/similarity.js.
DUPLICATE_SIMILARITY_THRESHOLD=40
MAX_ARTICLES_PER_DIGEST=17
CHECK_INTERVAL_MS=60000
# Active Phase-A scenario: sarcastic (prompt.md) | architect (prompt_deep.md).
ACTIVE_SCENARIO=sarcastic

# ─── Server-side content fetcher ─────────────────────────────────────────────
# Backfills articles saved without content (e.g. via Telegram) — the local Mac
# fetcher (real Chrome via AppleScript) is optional and Mac-only.
CONTENT_FETCH_INTERVAL_MS=120000
CONTENT_FETCH_BATCH_SIZE=5
CONTENT_FETCH_DOMAIN_DELAY_MS=3000
# Opt-in: proxy fetches for KNOWN_BLOCKED_DOMAINS (perplexity.ai, blocked by
# Cloudflare) through https://r.jina.ai/ instead of failing straight to
# fetch_failed. Sends the article URL to that third-party service.
JINA_READER_FALLBACK=false
# Optional: Bearer token for r.jina.ai, moves requests off Jina's anonymous
# rate limit (anonymous requests get abuse-blocked on perplexity.ai). Leave
# unset to fetch anonymously.
JINA_API_KEY=

# ─── Notifications ───────────────────────────────────────────────────────────
NTFY_TOPIC=news-digest-alexkrol

# ─── FB: источник постов ─────────────────────────────────────────────────────
# Read-only поллер профиля УДАЛЁН. FB-посты теперь добавляются вручную по ссылке
# через дашборд (POST /api/source-posts/fetch-url): чтение browserless (без
# headless-браузера) и работает на боевом сервере — никакого 503.
FB_PROFILE_URL=https://www.facebook.com/alex.v.krol

# ─── Publishing: Facebook Page (only Page is supported — no personal profile) ─
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ─── Publishing: Threads (§11 media-pipeline-spec.md) ────────────────────────
# Threads User Access Token via Threads Login/OAuth (separate app credentials
# from the Facebook Page token — see docs/facebook-page-setup.md for the FB
# side). Auto-refreshed by threads-token-refresh.js before the ~60-day expiry;
# the refreshed token is stored in the DB (threads_token_state), not written
# back here.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_LINK_TEXT=Full brief:
# Manual override for the link appended to every post. Leave unset to fall
# back to the Telegram channel link (t.me/theghostbrief) until the site URL (P3) ships.
THREADS_LINK_URL=

# ─── Publishing: Telegram ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Channel the digest is published to (falls back to TELEGRAM_CHAT_ID if unset).
TELEGRAM_PUBLISH_CHAT_ID=
# Обязателен для приёма новостей из Telegram: без него webhook работает
# fail-closed и отвергает все запросы (403).
TELEGRAM_WEBHOOK_SECRET=

# ─── Media generation (optional) ─────────────────────────────────────────────
FAL_KEY=

# ─── Planned integrations (status-only stubs — pipelines not implemented) ─────
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
GEMINI_API_KEY=
